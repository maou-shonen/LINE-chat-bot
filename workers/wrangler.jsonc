{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  // workers.dev stays as a fallback after the cutover.
  "workers_dev": true,
  // Deploying this config is the cutover. A non-interactive `wrangler deploy` creates the
  // custom domain and passes override_existing_dns_record=true, replacing the existing
  // linebot.maou.app CNAME. Removing this entry later does NOT delete the domain: wrangler
  // only publishes custom domains when the list is non-empty. Roll back via API/dashboard.
  "routes": [{ "pattern": "linebot.maou.app", "custom_domain": true }],
  // Opt-in diagnostic logging. Values are fixed phase names and numbers only.
  "vars": {
    "PHASE_TIMING": "0"
  },
  // invocation_logs records the request URL. Callback paths contain the channel secret.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ],
  "env": {
    "staging": {
      "name": "line-chat-bot-staging",
      // workers.dev only. routes is inherited from the top level, so clear it explicitly.
      "workers_dev": true,
      "routes": [],
      // wrangler does not inherit vars. Keep the default off here too.
      "vars": {
        "PHASE_TIMING": "0"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BOT_STATE",
            "class_name": "BotState"
          }
        ]
      },
      // wrangler does not inherit migrations. Staging needs its own v1 or BotState is not created.
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BotState"]
        }
      ],
      // invocation_logs records the request URL. Callback paths contain the channel secret.
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      }
    }
  }
}
