{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  // Placeholder only. A real account id belongs in CLOUDFLARE_ACCOUNT_ID, not in git.
  "account_id": "00000000000000000000000000000000",
  "vars": {
    // Empty disables POST /import. Staging sets the real value with `wrangler secret put IMPORT_SECRET --env staging`.
    "IMPORT_SECRET": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ],
  "env": {
    "staging": {
      "name": "line-chat-bot-staging",
      "workers_dev": false,
      "account_id": "00000000000000000000000000000000",
      "durable_objects": {
        "bindings": [
          {
            "name": "BOT_STATE",
            "class_name": "BotState"
          }
        ]
      }
    }
  }
}
