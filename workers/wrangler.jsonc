{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "line-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ],
  "env": {
    "staging": {
      "name": "line-chat-bot-staging",
      // workers.dev only. Do not add linebot.maou.app or any production route.
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          {
            "name": "BOT_STATE",
            "class_name": "BotState"
          }
        ]
      },
      // wrangler does not inherit migrations. Staging needs its own v1 or BotState is not created.
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BotState"]
        }
      ],
      // invocation_logs records the request URL. Callback paths contain the channel secret.
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      }
    }
  }
}
