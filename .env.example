# Copy to .env and fill in. App-level secrets live ONLY here, never in repo/image.
# Per-bot channel secret + access token stay in the webhook URL path by design.

# SQLAlchemy URL. Local/dev: sqlite:///./line.db  Prod: mysql+pymysql://user:pass@db:3306/line?charset=utf8mb4
DATABASE_URL=sqlite:///./line.db
# Google Safe Browsing API key (URL checks in groups)
GOOGLE_SAFE_BROWSING_KEY=
# imgur Client-ID for direct uploads (1:1 image messages)
IMGUR_CLIENT_ID=
# Developer feedback target: 意見 pushes here when BOTH are set,
# otherwise the bot replies that feedback isn't configured.
DEVELOPER_USER_ID=
DEVELOPER_BOT_TOKEN=
# Override in tests/load replays to point at a mock.
LINE_API_BASE_URL=https://api.line.me
LINE_DATA_API_BASE_URL=https://api-data.line.me
LOG_LEVEL=INFO
